{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "package.json", "use": "@vercel/next" },
    { "src": "api-go/health.go", "use": "@vercel/go" },
    { "src": "api-go/checkin.go", "use": "@vercel/go" },
    { "src": "api-go/reminders.go", "use": "@vercel/go" },
    { "src": "api-go/signup-reminders.go", "use": "@vercel/go" }
  ],
  "routes": [
    { "src": "/api-go/health", "dest": "/api-go/health.go" },
    { "src": "/api-go/checkin", "dest": "/api-go/checkin.go" },
    { "src": "/api-go/reminders", "dest": "/api-go/reminders.go" },
    { "src": "/api-go/signup-reminders", "dest": "/api-go/signup-reminders.go" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "crons": [
    { "path": "/api-go/reminders", "schedule": "0 14 * * *" },
    { "path": "/api-go/signup-reminders", "schedule": "0 14 * * 1" }
  ]
}
