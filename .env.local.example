# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, set these in Project Settings → Environment Variables.

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — used by the Go geolocation check-in function to
# write verified check-ins. Never expose to the browser / never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site --------------------------------------------------------------------
# Used to build the magic-link redirect URL. Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (transactional email — magic links + reminders) -----------------
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Office Hours <office-hours@yourdomain.com>

# --- Office location (overrides the constants in code) ----------------------
OFFICE_LATITUDE=37.86790
OFFICE_LONGITUDE=-122.25548

# --- Cron ------------------------------------------------------------------
# Vercel injects CRON_SECRET automatically for scheduled invocations; set the
# same value here for local testing of the reminders endpoint.
CRON_SECRET=generate-a-long-random-string
